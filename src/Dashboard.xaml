<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ethernet First · 网络守护" Width="1140" Height="900" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#20314E">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,11"/><Setter Property="Background" Value="#EAF0FC"/><Setter Property="Foreground" Value="#285CD4"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.83"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="44" Height="26" CornerRadius="13" Background="#CCD5E3"><Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#3269E8"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#E6EBF3"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#7A879D"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,12,0,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="#F5F7FB"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#F5F7FB" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,2" Foreground="#8493AA"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <TextBlock x:Name="SelectionLabel" Text="{Binding SelectedItem.Name,RelativeSource={RelativeSource TemplatedParent}}" Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#DBE4F1" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240" Padding="4"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="8,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  </Window.Resources>
  <Grid Background="#F3F6FB" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="166"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#142440">
      <Grid Margin="18,28,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Background="#3269E8" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left"><TextBlock Text="EF" FontWeight="Bold" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="Ethernet First" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,5"/>
          <TextBlock Text="让连接更从容" Foreground="#8FA6CB" FontSize="11"/>
          <Button x:Name="OverviewNav" Content="◉   网络总览" Margin="0,36,0,10" Background="#263D61" Foreground="White" Padding="10,12" HorizontalContentAlignment="Left"/>
          <Button x:Name="SettingsNav" Content="☷   连接设置" Margin="0,0,0,10" Background="Transparent" Foreground="#A9BBD8" Padding="10,12"/>
          <Button x:Name="HelpNav" Content="?   使用帮助" Background="Transparent" Foreground="#A9BBD8" Padding="10,12"/>
        </StackPanel>
        <StackPanel Grid.Row="2"><TextBlock Text="●  本机运行" Foreground="#6AD7BC" FontSize="12"/><TextBlock Text="不经过云端管理网络" Foreground="#8FA6CB" FontSize="10" Margin="0,8,0,0"/><TextBlock Text="关闭窗口后留在托盘" Foreground="#8FA6CB" FontSize="10" Margin="0,5,0,0"/></StackPanel>
      </Grid>
    </Border>
    <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,25,28,24">
        <Grid x:Name="OverviewSection" Margin="0,0,0,20"><StackPanel><TextBlock Text="网络总览" FontSize="26" FontWeight="Bold"/><TextBlock Text="两条线路，各自的连通状态，一眼看清。" Foreground="#7A879D" Margin="0,7,0,0"/></StackPanel><Border Background="White" CornerRadius="16" Padding="13,7" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="ModeText" Text="●  只检测模式" Foreground="#5A6D8E" FontSize="12"/></Border></Grid>
        <Border CornerRadius="16" Padding="24,21" Margin="0,0,0,18">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#203F78" Offset="0"/><GradientStop Color="#2E65C6" Offset="1"/></LinearGradientBrush></Border.Background>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="当前默认出口" Foreground="#BACFEE" FontSize="12"/><TextBlock x:Name="CurrentTitle" Text="正在读取连接" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,8"/><TextBlock x:Name="CurrentDetail" Foreground="#E1EBFC" Text="首次检测将在片刻后完成" TextWrapping="Wrap"/><TextBlock x:Name="CheckedText" Text="等待首次检测" Foreground="#B0C9EE" FontSize="11" Margin="0,15,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"><Button x:Name="CheckButton" Content="↻  立即检测" Background="White" Foreground="#285CD4"/><TextBlock x:Name="BusyText" Text="正在检测两条线路…" Foreground="#DBE8FF" FontSize="11" Margin="0,10,0,0" HorizontalAlignment="Center"/><ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Margin="0,7,0,0" Foreground="#8EC5FF" Background="#345A94"/></StackPanel>
          </Grid>
        </Border>
        <Border x:Name="NoticeBorder" Background="#E8EFFC" CornerRadius="10" Padding="14,11" Margin="0,0,0,18"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" LineHeight="21" Foreground="#49648E"/></Border>
        <Grid x:Name="LinksGrid" Margin="0,0,0,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="WiredCard" Style="{StaticResource Card}"><StackPanel>
            <Grid><StackPanel Orientation="Horizontal"><Border Background="#EAF0FC" Width="36" Height="36" CornerRadius="10"><Path Data="M 6,2 L 22,2 22,15 18,15 18,21 10,21 10,15 6,15 Z M 10,3 L 10,8 M 14,3 L 14,8 M 18,3 L 18,8" Stroke="#3269E8" StrokeThickness="1.7" Width="25" Height="25" Stretch="Uniform"/></Border><TextBlock Text="有线网络" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel><Border x:Name="WiredBadgeBorder" Background="#F0F3F8" CornerRadius="10" Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="WiredBadge" Text="未连接" FontSize="10" Foreground="#6D7F9A"/></Border></Grid>
            <ComboBox x:Name="WiredSelector" DisplayMemberPath="Name" SelectedValuePath="Guid" ToolTip="选择要管理的有线网卡；两项都选自动时，使用唯一的物理网卡。"/>
            <TextBlock x:Name="WiredSubtitle" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <Grid Margin="0,5"><TextBlock Text="国内连通" VerticalAlignment="Center"/><Border x:Name="WiredDomesticBg" HorizontalAlignment="Right" CornerRadius="7" Padding="11,4"><TextBlock x:Name="WiredDomestic" FontWeight="SemiBold" FontSize="12"/></Border></Grid>
            <Grid Margin="0,7,0,14"><TextBlock Text="国外连通" VerticalAlignment="Center"/><Border x:Name="WiredForeignBg" HorizontalAlignment="Right" CornerRadius="7" Padding="11,4"><TextBlock x:Name="WiredForeign" FontWeight="SemiBold" FontSize="12"/></Border></Grid>
            <Button x:Name="WiredButton" Content="优先使用有线" HorizontalAlignment="Stretch"/>
          </StackPanel></Border>
          <Border x:Name="WifiCard" Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
            <Grid><StackPanel Orientation="Horizontal"><Border Background="#ECF5F3" Width="36" Height="36" CornerRadius="10"><Path Data="M 1,8 Q 14,-3 27,8 M 5,13 Q 14,5 23,13 M 9,18 Q 14,13 19,18 M 14,22 L 14,23" Stroke="#16866A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="25" Height="25" Stretch="Uniform"/></Border><TextBlock Text="Wi-Fi 网络" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel><Border x:Name="WifiBadgeBorder" Background="#F0F3F8" CornerRadius="10" Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="WifiBadge" Text="未连接" FontSize="10" Foreground="#6D7F9A"/></Border></Grid>
            <ComboBox x:Name="WifiSelector" DisplayMemberPath="Name" SelectedValuePath="Guid" ToolTip="选择要管理的 Wi-Fi 网卡。"/>
            <TextBlock x:Name="WifiSubtitle" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <Grid Margin="0,5"><TextBlock Text="国内连通" VerticalAlignment="Center"/><Border x:Name="WifiDomesticBg" HorizontalAlignment="Right" CornerRadius="7" Padding="11,4"><TextBlock x:Name="WifiDomestic" FontWeight="SemiBold" FontSize="12"/></Border></Grid>
            <Grid Margin="0,7,0,14"><TextBlock Text="国外连通" VerticalAlignment="Center"/><Border x:Name="WifiForeignBg" HorizontalAlignment="Right" CornerRadius="7" Padding="11,4"><TextBlock x:Name="WifiForeign" FontWeight="SemiBold" FontSize="12"/></Border></Grid>
            <Button x:Name="WifiButton" Content="优先使用 Wi-Fi" HorizontalAlignment="Stretch"/>
          </StackPanel></Border>
        </Grid>
        <Border x:Name="SettingsSection" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
          <TextBlock Text="连接设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,19"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,28,0"><TextBlock Text="自动故障切换" FontWeight="SemiBold"/><TextBlock Text="当前线路国内访问持续失败，才切换到已确认可用的备用线路。" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="AutoSwitch" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="自动故障切换"/></Grid>
          <Border Height="1" Background="#EDF0F6" Margin="0,17"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,28,0"><TextBlock Text="有线恢复后自动切回" FontWeight="SemiBold"/><TextBlock Text="仅在自动模式生效。有线的国内、国外检测都确认恢复后，再切回有线。" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="ReturnSwitch" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="有线恢复后自动切回"/></Grid>
          <Border Height="1" Background="#EDF0F6" Margin="0,17"/>
          <WrapPanel><Button x:Name="CancelAdaptersButton" Content="撤销选择" Visibility="Collapsed" Padding="14,9" Background="#F0F3F8" Foreground="#536781" Margin="0,0,10,8"/><Button x:Name="SaveAdaptersButton" Content="保存网卡选择" Padding="14,9" Margin="0,0,10,8"/><Button x:Name="RestoreButton" Content="恢复原设置" Padding="14,9" Background="#F0F3F8" Foreground="#536781" Margin="0,0,10,8"/><Button x:Name="HideButton" Content="最小化到托盘" Padding="14,9" Background="#F0F3F8" Foreground="#536781" Margin="0,0,0,8"/></WrapPanel>
          <TextBlock x:Name="SelectionHint" Text="手动切换会关闭自动模式；每次启动也默认只检测。" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="最近动态" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="#8B98AC" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#596D8A" FontSize="12"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border x:Name="HelpSection" Style="{StaticResource Card}"><StackPanel><TextBlock Text="使用提示" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="• 国内与国外状态来自各组检测站点，不能代表所有网站。正常状态需要连续两次确认，故障需要三次确认。&#10;• 只有国外检测失败时，保持当前线路，避免两条国内线路之间反复切换。&#10;• 自动切换有 180 秒冷却。VPN、出口不明确或外部修改优先级时，会暂停自动控制。&#10;• 切换仅改变网卡优先级，已有长连接可能要重新连接。恢复原设置会关闭自动模式。" Style="{StaticResource Muted}" FontSize="12"/><Expander Header="诊断信息" Margin="0,13,0,0" Foreground="#647994"><TextBox x:Name="DiagnosticText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="#F5F7FB" Padding="10" Margin="0,8,0,0" FontSize="11"/></Expander></StackPanel></Border>
        <TextBlock Text="Ethernet First  /  双线路连通面板" Foreground="#98A4B7" HorizontalAlignment="Center" FontSize="10" Margin="0,20,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
